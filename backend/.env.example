APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_HOURS=72
# Origin công khai của backend để dựng URL tuyệt đối cho file upload.
# Để trống -> tự suy từ request (dev). Production sau TLS-proxy nên set rõ,
# vd: https://api.example.com
PUBLIC_BASE_URL=
# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Để trống -> "*" (chỉ hợp lệ ở dev). Khi APP_ENV=production mà vẫn còn "*"
# thì app sẽ DỪNG lúc khởi động, xem Config.validateProduction().
# vd: https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lpbuilder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lpbuilder
