APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_HOURS=72
# Origin công khai của backend để dựng URL tuyệt đối cho file upload.
# Để trống -> tự suy từ request (dev). Production sau TLS-proxy nên set rõ,
# vd: https://api.example.com
PUBLIC_BASE_URL=
# Danh sách origin được phép gọi API, ngăn cách bằng dấu phẩy.
# Để trống -> "*" (chỉ hợp lệ ở dev). Khi APP_ENV=production mà vẫn còn "*"
# thì app sẽ DỪNG lúc khởi động, xem Config.validateProduction().
# vd: https://app.example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=lpbuilder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lpbuilder

# --- MOMO CONFIG ---
# Khoá sandbox lấy ở https://developers.momo.vn. KHÔNG commit khoá thật.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# Đường dẫn FE mà MoMo chuyển hướng khách về sau khi thanh toán xong.
MOMO_RETURN_URL=http://localhost:5173/payment-result
# Webhook (IPN) MoMo gọi về để báo kết quả. MoMo cần domain public -> dùng ngrok khi dev.
# BẮT BUỘC có tiền tố /p: route nằm trong group công khai api.Group("/p") ở router.go.
# Thiếu /p thì MoMo nhận 404 và khách trả tiền xong vẫn ở gói free.
MOMO_NOTIFY_URL=https://<ngrok-domain>/api/v1/p/payment/webhook
