# ===== Database =====
POSTGRES_USER=lpbuilder
POSTGRES_PASSWORD=changeme
POSTGRES_DB=lpbuilder
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ===== Backend =====
APP_PORT=8080
APP_ENV=development
JWT_SECRET=change-this-secret-in-production
JWT_EXPIRE_HOURS=72
# Origin được phép gọi API, ngăn cách bằng dấu phẩy. Để trống -> "*" (chỉ dev).
# APP_ENV=production mà JWT_SECRET/POSTGRES_PASSWORD còn giá trị mặc định hoặc
# CORS còn "*" thì backend sẽ DỪNG lúc khởi động thay vì chạy mất an toàn.
CORS_ALLOWED_ORIGINS=

# ===== Frontend =====
VITE_API_BASE_URL=http://localhost:8080/api/v1
