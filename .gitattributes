# Chuẩn hóa line ending cho toàn repo.
#
# Lý do: team dùng Windows với core.autocrlf=true, nên working tree bị CRLF
# trong khi git lưu LF. Hậu quả: `gofmt -l` báo sai TOÀN BỘ 45 file .go
# (không phải code sai format, mà là chênh lệch line ending), khiến lệnh này
# vô dụng để kiểm tra chất lượng.
#
# Cách xử lý: ép LF ở cả git lẫn working tree, trên mọi OS.

# Mặc định: git tự nhận diện file text, luôn lưu và checkout bằng LF
* text=auto eol=lf

# ---- Go ----
# Bắt buộc LF, nếu không gofmt / go vet sẽ báo sai
*.go     text eol=lf
go.mod   text eol=lf
go.sum   text eol=lf
*.toml   text eol=lf

# ---- Frontend ----
*.jsx    text eol=lf
*.js     text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.json   text eol=lf

# ---- Database ----
*.sql    text eol=lf

# ---- Config / hạ tầng ----
*.yml    text eol=lf
*.yaml   text eol=lf
*.conf   text eol=lf
Dockerfile   text eol=lf
*.example    text eol=lf

# Script shell: CRLF làm hỏng shebang khi chạy trong container Linux
*.sh     text eol=lf

# ---- Tài liệu ----
*.md     text eol=lf

# ---- File nhị phân: git KHÔNG được đụng vào nội dung ----
*.exe    binary
*.docx   binary
*.pdf    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
